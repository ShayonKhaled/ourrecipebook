{{/* Overrides themes/coyote/layouts/_default/index.json.
   Only pages with a real image are indexed; the theme emitted a broken
   ".../about/<nil>" URL for pages without one. */}}
{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- $page := . -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) .Params.image -}}
        {{- with .Resources.GetMatch .Params.image -}}
            {{- $.Scratch.Add "index" (dict "title" $page.Title "content" $page.Plain "permalink" $page.Permalink "summary" $page.Summary "date" ($page.Date.Format "2006/01/02") "image" .Permalink) -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
